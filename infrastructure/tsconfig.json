{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node18",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Off deliberately: aws-cdk-lib's own declarations model optional properties as `T | undefined`
    // rather than as absent, so this flag rejects the library's own types rather than our code.
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
